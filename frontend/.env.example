# MockMate — frontend environment variables (example)
#
# Copy this file to `.env.local` and fill in the values from your own Supabase
# project. `.env.local` is git-ignored and must never be committed.
#
#   cp .env.example .env.local
#
# Find these under: Supabase Dashboard → Project Settings → API.
# These are PUBLIC client values. Never place a database password or a
# service-role / secret key in a VITE_* variable — Vite inlines them into the
# client bundle and anyone can read them.

# Your project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Public client key. New projects issue a "publishable" key; older projects
# issue an "anon" key. Provide whichever your project offers.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the MockMate backend API (Express server in ./backend).
# Optional — defaults to http://localhost:4000 when unset.
VITE_API_BASE_URL=http://localhost:4000
