# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env — it is ignored by .gitignore.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed browser origins (the frontend dev server, etc.).
FRONTEND_ORIGIN=http://localhost:8443

# Supabase project URL (public). Same value as VITE_SUPABASE_URL in the frontend.
SUPABASE_URL=

# Supabase public client key (public). Either the new publishable key or the
# legacy anon key. Same value the frontend uses. This is NOT a privileged
# secret �?" ordinary user requests never use the service-role key.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Backend-only privileged key for account deletion (Auth admin delete + deletion
# audit status). Never expose this through a VITE_* variable. Either the legacy
# service_role key or the newer secret key is accepted. When unset, the Delete
# Account endpoint returns 503 instead of pretending deletion succeeded.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Groq API key used for resume analysis, interview evaluation, roadmap plans and
# topic learning resources. This is a SECRET and must stay on the backend only —
# never expose it to the frontend or commit it. Create one at
# https://console.groq.com/keys.
GROQ_API_KEY=

# Model used for structured AI responses. Optional; when omitted the backend
# falls back to `openai/gpt-oss-120b`, a currently supported Groq production
# model that returns structured JSON. Other supported choices include
# `openai/gpt-oss-20b`, `llama-3.3-70b-versatile` and `llama-3.1-8b-instant`.
GROQ_MODEL=

# Optional override for the Groq API base URL. Defaults to
# https://api.groq.com/openai/v1 and normally does not need to be set.
# GROQ_API_URL=

# Himalayas Remote Jobs API (optional) — one external job provider in the Job
# Portal. The public API works without a key; a key only raises rate limits.
# Create one at https://himalayas.app/docs/remote-jobs-api.
#
# Attribution is required: keep a visible link back to https://himalayas.app and
# send users to each listing's original application URL. Do not redistribute the
# listings to third-party job boards or aggregators.
#
# This key is a SECRET. Keep it on the backend only; never expose it through a
# VITE_* variable or commit backend/.env.
HIMALAYAS_API_KEY=

# ---------------------------------------------------------------------------
# Coding Round (Interview module — OnlineCompiler.io execution API)
# ---------------------------------------------------------------------------
# The Coding Round is separate from Problem Solving. Code runs are sent to
# OnlineCompiler.io's synchronous endpoint
# (POST https://api.onlinecompiler.io/api/run-code-sync/) from the backend only.
#
# This key is a SECRET. Keep it on the backend; never expose it through a VITE_*
# variable or commit backend/.env. Create a key of type "API" (not a widget key)
# at https://api.onlinecompiler.io/compilers/api-keys/. The provider expects the
# bare key in the Authorization header — do not add a "Bearer " prefix.
#
# When this is unset, the Coding Round UI still loads but execution returns a
# clear "not configured" error; no fallback or mock execution is used.
ONLINECOMPILER_API_KEY=

# Base URL for the provider. Override only for a compatible self-hosted proxy.
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io

# HTTP timeout for one synchronous run, in milliseconds (5000-45000). The
# provider caps a synchronous request at 30 seconds.
ONLINECOMPILER_TIMEOUT_MS=32000

# ---------------------------------------------------------------------------
# Problem Solving (AI-generated coding problems with real sandboxed grading)
# ---------------------------------------------------------------------------
# User code is NEVER executed in the Express process. Submissions are sent to a
# Piston-compatible sandbox. The public service may require a bearer token; set
# CODE_EXECUTION_API_KEY when needed. It is a shared third-party service: use a
# self-hosted Piston instance for production and for any code that must not
# leave your infrastructure.
CODE_EXECUTION_URL=https://emkc.org/api/v2/piston

# Optional bearer token for a self-hosted/protected Piston endpoint.
# CODE_EXECUTION_API_KEY=

# Total HTTP timeout for one sandbox request, in milliseconds (1000-60000).
CODE_EXECUTION_TIMEOUT_MS=15000

# Runtime versions understood by the sandbox. Adjust to match the Piston image
# you deploy (list them at GET /api/v2/piston/runtimes).
# CODE_EXECUTION_PYTHON_VERSION=3.10.0
# CODE_EXECUTION_JAVASCRIPT_VERSION=18.15.0

# SECRET used to encrypt hidden tests and reference approaches (AES-256-GCM)
# before they are written to the database. When unset, the backend derives key
# material from GROQ_API_KEY so the feature still works, but production
# deployments must set a dedicated long random secret. Rotating it makes
# existing encrypted data unreadable (those questions can no longer be graded).
PROBLEM_TEST_SECRET=

# Jobicy Remote Jobs API — the second external provider. It uses the keyless
# public API at https://jobicy.com/api/v2/remote-jobs, so no environment
# variable is required. Jobicy asks clients to credit the source, link to the
# original Jobicy listing, and synchronize no more frequently than once per hour.
# The backend caches Jobicy responses for one hour.
#
# Do not add a Jobicy Commercial API key unless a paid plan has been approved:
# commercial requests can debit the API wallet.

